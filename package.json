{
  "name": "argus",
  "productName": "Argus",
  "version": "1.0.0",
  "description": "Mastery rank planner and live companion for Warframe: world state, inventory, builds and an in-game overlay",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Kr3akz",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Kr3akz/Argus",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kr3akz/Argus.git"
  },
  "bugs": {
    "url": "https://github.com/Kr3akz/Argus/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.mjs",
    "check-farm": "node tools/check-farm-nodes.mjs",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "report": "node src/cli/report.js",
    "scan-test": "node src/cli/scan-test.js",
    "inventory": "node src/cli/inventory-fetch.js",
    "inventory-test": "node src/cli/inventory-test.js",
    "notif-test": "node src/cli/notif-test.js",
    "relic-test": "node src/cli/relic-test.js",
    "ocr-probe": "node src/cli/ocr-probe.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^3.1.5"
  }
}
