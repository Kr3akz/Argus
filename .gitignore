# ---------------------------------------------------------------------------
# Abhaengigkeiten
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Persoenliche Daten - NIEMALS committen.
#
# data/ enthaelt die accountId, das abgerufene Profil und das komplette
# Inventar des Spielkontos. Deshalb wird der gesamte Ordner ignoriert und
# einzeln freigegeben, was oeffentlich sein darf - nicht umgekehrt. Eine neue
# Cache-Datei ist damit automatisch ignoriert, statt aus Versehen im Commit
# zu landen.
#
#   config.json      accountId
#   profile-*.json   Profildaten, Dateiname enthaelt die accountId
#   inventory*.json  vollstaendiges Inventar des Kontos
#   goals.json       Ziele, Notizen, Builds
#   scan-hint.json   Speicheradresse des Spielprozesses
#   ratelimit.json   lokaler Drosselungsstand
#   catalog.json     9 MB oeffentlicher Cache, wird neu geladen
#   mods.json        2,5 MB oeffentlicher Cache, wird neu geladen
# ---------------------------------------------------------------------------
data/*
!data/config.example.json

# ---------------------------------------------------------------------------
# IDE und Betriebssystem
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Builds und Logs
# ---------------------------------------------------------------------------
dist/
out/
build/
release/
*.log
npm-debug.log*

# Commit und Bauzeitpunkt, geschrieben von .github/workflows/release.yml
# unmittelbar vor dem Paketieren. Entsteht im Lauf, gehoert nicht ins
# Repository - eine committete Fassung wuerde in jedem Build denselben,
# laengst veralteten Commit ausweisen.
build-info.json

# ---------------------------------------------------------------------------
# Zugangsdaten
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key

# ---------------------------------------------------------------------------
# Ausnahme: build/ ist oben als Ausgabeordner gesperrt, enthaelt fuer
# electron-builder aber die Bau-Ressourcen. Das Programmsymbol muss mit ins
# Repository, sonst kann die Veroeffentlichung auf einem fremden Rechner
# (GitHub Actions) kein Paket bauen.
# ---------------------------------------------------------------------------
!build/
build/*
!build/icon.png
